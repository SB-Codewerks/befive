{:role #keyword #or [#env BEFIVE_ROLE "all"]
 :node-id #or [#env BEFIVE_NODE_ID ""]
 :environment #or [#env BEFIVE_ENVIRONMENT "dev"]
 :db-url #or [#env BEFIVE_DB_URL "jdbc:postgresql://127.0.0.1:5432/befive"]
 :db-user #or [#env BEFIVE_DB_USER "befive"]
 :db-password #or [#env BEFIVE_DB_PASSWORD "befive"]
 :db-password-file #or [#env BEFIVE_DB_PASSWORD_FILE ""]
 :migrate-on-start #boolean #or [#env BEFIVE_MIGRATE_ON_START "true"]
 :eval #boolean #or [#env BEFIVE_EVAL "false"]
 :trusted-proxies #or [#env BEFIVE_TRUSTED_PROXIES ""]
 :ops-port #long #or [#env BEFIVE_OPS_PORT "9901"]
 :gateway-port #long #or [#env BEFIVE_GATEWAY_PORT "8080"]
 :admin-port #long #or [#env BEFIVE_ADMIN_PORT "9000"]
 :db-startup-timeout-ms #long #or [#env BEFIVE_DB_STARTUP_TIMEOUT_MS "60000"]
 :redis-uri #or [#env BEFIVE_REDIS_URI ""]
 :snapshot-file #or [#env BEFIVE_SNAPSHOT_FILE ""]
 :lkg-dir #or [#env BEFIVE_LKG_DIR "/var/lib/befive/lkg"]}
